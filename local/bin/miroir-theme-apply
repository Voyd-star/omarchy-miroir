#!/usr/bin/env bash
# Apply extras on Omarchy theme change.
# Triggered by miroir-theme-apply.path (watches current/theme.name).
set -uo pipefail
# Feature toggles written by install.sh — missing file = everything on.
[[ -f "$HOME/.config/miroir/features.conf" ]] && . "$HOME/.config/miroir/features.conf"
CUR="$HOME/.config/omarchy/current/theme"
COLORS="$CUR/colors.toml"
[[ -f "$COLORS" ]] || exit 0
val() { grep -E "^$1 " "$COLORS" | head -1 | cut -d'"' -f2; }
acc=$(val accent); bg=$(val background); fg=$(val foreground); c8=$(val color8)

# 0) Run the Omarchy theme-set hook framework (Discord/Steam/Typora/Spotify/GTK... from colors.toml).
#    Omarchy 4.0 no longer calls it natively, so we trigger it here. On 3.x Omarchy
#    already runs it via `omarchy-hook theme-set` — re-running it would theme twice.
omarchy_major="$(omarchy-version 2>/dev/null | grep -oE '[0-9]+' | head -1)"; : "${omarchy_major:=3}"
if [ "$omarchy_major" -ge 4 ] && [[ -x "$HOME/.config/omarchy/hooks/theme-set" ]]; then
  bash "$HOME/.config/omarchy/hooks/theme-set" >/dev/null 2>&1 || true
fi

# 1) Razer keyboard -> theme accent (no-op if no Razer connected)
if [[ "${MIROIR_RAZER:-1}" = 1 ]] && command -v polychromatic-cli >/dev/null 2>&1; then
  polychromatic-cli -d keyboard -o static -c "$acc" >/dev/null 2>&1 || true
fi

# 2) tmux theme from palette
if [[ "${MIROIR_TMUX:-1}" = 1 ]]; then
TDIR="$HOME/.config/tmux"; mkdir -p "$TDIR"
cat > "$TDIR/miroir.conf" <<EOF
# auto-generated by miroir-theme-apply — do not edit
set -g status-style "bg=$bg,fg=$fg"
set -g status-left-style "bg=$acc,fg=$bg"
set -g window-status-current-style "bg=$acc,fg=$bg,bold"
set -g window-status-style "fg=$fg"
set -g pane-active-border-style "fg=$acc"
set -g pane-border-style "fg=$c8"
set -g message-style "bg=$acc,fg=$bg"
set -g mode-style "bg=$acc,fg=$bg"
set -g clock-mode-colour "$acc"
EOF
grep -q 'miroir.conf' "$TDIR/tmux.conf" 2>/dev/null || echo 'source-file ~/.config/tmux/miroir.conf' >> "$TDIR/tmux.conf"
tmux info >/dev/null 2>&1 && tmux source-file "$TDIR/miroir.conf" >/dev/null 2>&1 || true
fi

# 4) Hyprland — accent border gradient + shadow glow follow the theme. Write BOTH:
if [[ "${MIROIR_HYPR:-1}" = 1 ]]; then
#    - miroir-theme.conf (hyprlang, Omarchy 3.8.x) — sourced by looknfeel.conf
#    - miroir-theme.lua  (lua,     Omarchy 4.0)   — dofile'd by looknfeel.lua
c6=$(val color6)
a=${acc#\#}; c=${c6#\#}
cat > "$HOME/.config/hypr/miroir-theme.conf" <<EOF
# auto-generated by miroir-theme-apply — border + shadow follow the theme accent
general {
    col.active_border = rgba(${a}ee) rgba(${c}ee) 45deg
}
decoration {
    shadow {
        color = rgba(${a}66)
    }
}
EOF
cat > "$HOME/.config/hypr/miroir-theme.lua" <<EOF
-- auto-generated by miroir-theme-apply — border + shadow follow the theme accent
hl.config({
  general = { col = { active_border = { colors = { "rgba(${a}ee)", "rgba(${c}ee)" }, angle = 45 } } },
  decoration = { shadow = { color = "rgba(${a}66)" } },
})
EOF
command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true
fi

# Discord/Typora/Spotify/GTK are themed by the framework in step 0.
exit 0
